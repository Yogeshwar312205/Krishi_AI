# ai-engine configuration. Copy to ai-engine/.env and fill in.

# FastAPI bind (optional; defaults shown)
PORT=8000
HOST=0.0.0.0

# OpenWeather "Current Weather Data" API key.
# Get one free at https://home.openweathermap.org/api_keys
# Used only by the rule-based price context scorer
# (app/services/price_service.py, SECTION 2). If left blank, the weather term
# is dropped from the score and everything else still works.
OPENWEATHER_API_KEY=

# --- Trained price forecast model (app/services/forecast_model.py) ---
#
# Nothing here needs setting. The loader prefers
# app/models/mandi_price_model.ubj + .meta.json, which are checked in and load
# cleanly. Both settings below are escape hatches.

# Path to the ORIGINAL joblib bundle, used only if the .ubj pair is missing.
# Relative paths resolve against ai-engine/.
# PRICE_MODEL_PATH=app/models/mandi_price_model.pkl

# Override the model's intercept (₹/quintal), for the .pkl fallback path only.
# The training run wrote base_score in array form ([2.424006E3]); XGBoost 2.1.x
# cannot parse that and resets it to 0.5, which drags every prediction ~₹2424
# too low. forecast_model.py recovers the real value from the pickle's own
# bytes automatically, so set this only to force a different one.
# PRICE_MODEL_BASE_SCORE=
