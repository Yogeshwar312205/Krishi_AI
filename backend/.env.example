PORT=5000
NODE_ENV=production
MONGODB_URI=your_mongodb_atlas_connection_string
JWT_SECRET=your_jwt_secret_key
PYTHON_ENGINE_URL=http://localhost:8000

# data.gov.in key for the Agmarknet daily mandi price feed.
# Without this the service falls back to data.gov.in's shared sample key, which
# is aggressively rate-limited and answers 429 under any real use.
# Get your own (free, instant): https://data.gov.in/user
AGMARKNET_API_KEY=your_data_gov_in_api_key
